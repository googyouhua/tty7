#!/bin/sh
# tty7-as — run tty7 against a per-user instance on a shared box.
#
# Several people logged in as the SAME OS user (e.g. everybody is root) share
# one default tty7 server at $HOME/.config/tty7, so everyone can see and drive
# everyone else's panes. This wrapper gives each person an independent
# instance — own server, own control socket, own workspaces and panes — by
# mapping a short user name to an independent config directory:
#
#   tty7-as alice status
#   tty7-as alice new ~/code/api
#   tty7-as alice run -- cargo test
#   tty7-as alice --print-dir
#
# GUI: launch with the same directory, e.g.
#   tty7 --config-dir ~/.config/tty7-alice
# A remote link is per instance too, so each laptop user connects to (and only
# sees) their own instance on the shared box.
#
# Honest isolation, not hard security: the same OS user can still read another
# instance's files given enough will. It stops accidents and everyday
# snooping; it does not stop a malicious root.
#
# The instance lives at ${TTY7_AS_ROOT:-$HOME/.config}/tty7-<name>; only that
# leaf directory is created (mode 700), its parents are left alone.
set -eu

usage() {
  cat <<'EOF'
usage: tty7-as <name> [--] [tty7 args...]
       tty7-as <name> --print-dir

Run the tty7 CLI against the per-user instance <name>.
<name> must be lowercase letters, digits, or hyphens (e.g. alice).

The instance lives at ${TTY7_AS_ROOT:-$HOME/.config}/tty7-<name>.
With no tty7 args, behaves like bare `tty7` for that instance.
EOF
}

die() {
  printf 'tty7-as: %s\n' "$1" >&2
  exit "${2:-1}"
}

[ "$#" -ge 1 ] || { usage >&2; exit 2; }

name=$1
shift

case "$name" in
  -h | --help | help)
    usage
    exit 0
    ;;
esac

case "$name" in
  -* | "" | *[!a-z0-9-]*)
    die "bad instance name '$name' (use [a-z0-9-], e.g. alice)" 2
    ;;
esac

root="${TTY7_AS_ROOT:-}"
if [ -z "$root" ]; then
  [ -n "${HOME:-}" ] || die "\$HOME is unset and TTY7_AS_ROOT is not set" 1
  root="$HOME/.config"
fi
dir="$root/tty7-$name"

if [ "${1:-}" = "--print-dir" ]; then
  [ "$#" -eq 1 ] || { usage >&2; exit 2; }
  printf '%s\n' "$dir"
  exit 0
fi

if [ "${1:-}" = "--" ]; then
  shift
fi

command -v tty7 >/dev/null 2>&1 || die "tty7 not found on PATH (install tty7 and launch it once first)" 1

mkdir -p "$dir"
chmod 700 "$dir"

TTY7_CONFIG_DIR="$dir"
export TTY7_CONFIG_DIR
exec tty7 "$@"
